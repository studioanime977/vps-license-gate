# =============================================================
#  Plantilla de configuración del generador (SIN datos reales)
#  -------------------------------------------------------------
#  COPIA este archivo como:  config-generador.ps1
#  y pon ahí TU configuración real. NUNCA subas config-generador.ps1
#  a GitHub ni lo compartas.
# =============================================================

# URL de la Realtime Database (solo el nombre, sin https:// ni .json)
$FB_BASE = "TU-PROYECTO-default-rtdb.firebaseio.com"

# Rama donde viven las licencias (déjalo igual si usas el gate por defecto)
$FB_LICENCIAS = "licencias_movivip"

# Días de validez por defecto para nuevas keys
$DIAS_DEFAULT = 30

# Plan por defecto
$PLAN_DEFAULT = "standard"
